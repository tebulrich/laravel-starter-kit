APP_NAME="Laravel Starter Kit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://localhost
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

DEBUGBAR_ENABLED=false
TELESCOPE_ENABLED=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=password

# Compose starts only the profile named here (mysql or pgsql). Set by bin/setup.
COMPOSE_PROFILES=mysql

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Auth: Passport is default. Session-only disables API token routes via feature flag.
AUTH_PROVIDER=native
STARTER_SAMPLE_API=true
STARTER_FEATURE_PASSPORT=true
STARTER_FEATURE_SENTRY=true
STARTER_FEATURE_AUTHENTIK=false
STARTER_FRONTEND_LAYOUT=monolith

CORS_ALLOWED_ORIGINS=https://localhost,http://127.0.0.1:5173,http://localhost:5173,https://127.0.0.1:5173,https://localhost:5173

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

DOCKER_WWWUSER=www
DOCKER_WWWGROUP=www
OCTANE_WORKERS=4

APP_PORT_HTTP=80
APP_PORT_HTTPS=443
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_UI_PORT=8025
FORWARD_MAILPIT_SMTP_PORT=1025
APP_PORT_XDEBUG=8081
