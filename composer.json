{
    "name": "tebulrich/laravel-starter-kit",
    "type": "project",
    "description": "Laravel starter kit (PHP 8.5, Laravel 13, FrankenPHP, Redis).",
    "keywords": [
        "laravel",
        "framework",
        "starter-kit"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-zlib": "*",
        "laravel/framework": "^13.0",
        "laravel/octane": "^2.11",
        "laravel/passport": "^13.0",
        "laravel/tinker": "^3.0",
        "predis/predis": "^3.2",
        "sentry/sentry-laravel": "^4.16"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "brianium/paratest": "^7.24",
        "driftingly/rector-laravel": "^2.0",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.6",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/telescope": "^5.16",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "rector/rector": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "StarterKit\\Setup\\": "setup/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:parallel": [
            "@php artisan test --parallel"
        ],
        "setup": [
            "bin/setup"
        ],
        "code-quality": [
            "./scripts/code-quality.sh"
        ],
        "code-quality:check": [
            "./scripts/code-quality.sh --dry-run"
        ],
        "code-security": [
            "./scripts/code-security.sh"
        ],
        "code-security:check": [
            "./scripts/code-security.sh check"
        ],
        "code-security:sast": [
            "./scripts/code-security.sh sast"
        ],
        "code-security:sca": [
            "./scripts/code-security.sh sca"
        ],
        "code-security:dast": [
            "./scripts/code-security.sh dast"
        ],
        "code-security:sbom": [
            "./scripts/code-security.sh sbom"
        ],
        "code-security:image-scan": [
            "./scripts/code-security.sh image-scan"
        ],
        "code-security:secrets": [
            "./scripts/code-security.sh secrets"
        ],
        "code-security:all": [
            "./scripts/code-security.sh all"
        ],
        "test:scripts": [
            "./scripts/tests/code-security-runtime.test.sh",
            "./scripts/tests/require-setup.test.sh",
            "./scripts/tests/create-app.test.sh"
        ],
        "test:wizard-matrix": [
            "@php vendor/bin/pest -c qa/phpunit.xml --group wizard-matrix"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
