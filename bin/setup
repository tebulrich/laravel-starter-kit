#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [ ! -f composer.json ]; then
  echo "Run bin/setup from the project root." >&2
  exit 1
fi

if [ ! -f .env ]; then
  cp .env.example .env
fi

if [ ! -d vendor ]; then
  echo "Installing Composer dependencies..."
  composer install --no-interaction --prefer-dist --optimize-autoloader
fi

exec php setup/cli.php "$@"
